# Copy to `.env` and adjust. This file is safe to commit; `.env` is gitignored.

# ── Required
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost/billdb

# ── Database
SQL_ECHO=false

# ── Receipt LLM (Ollama) — used by services/receipt_parser via llm_receipt_parser
# off | fallback | always
RECEIPT_LLM_MODE=off
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SEC=300
OLLAMA_MAX_RETRIES=2

# ── process_bill() helper (ocr_service) — tries llm_service.structure_bill when true
USE_LLM_PROCESS_BILL=true

# ── OCR
OCR_DEBUG=true
OCR_MIN_CONFIDENCE=0.3
OCR_PREPROCESS_MAX_SIDE=1600
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=true

# ── API
CORS_ALLOW_ORIGINS=*
LOG_LEVEL=INFO
UPLOAD_FOLDER=uploads
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000

# ── Optional (middleware already reads these from the environment)
# API_LOG_SKIP_PATHS=/docs,/redoc,/openapi.json,/favicon.ico
# API_LOG_LOG_OPTIONS=false
